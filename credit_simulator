#!/bin/sh
# ─────────────────────────────────────────────────────
# credit_simulator — launcher script untuk Credit Simulator
#
# Penggunaan:
#   ./credit_simulator                  (mode interaktif)
#   ./credit_simulator file_inputs.txt  (mode file)
# ─────────────────────────────────────────────────────

# Cari lokasi script ini sehingga bisa dijalankan dari mana saja
DIR="$(cd "$(dirname "$0")" && pwd)"
JAR="$DIR/target/credit-simulator-1.0.0.jar"

# Pastikan JAR sudah ada (sudah di-build)
if [ ! -f "$JAR" ]; then
  echo "ERROR: JAR belum ada. Jalankan dulu: mvn package"
  exit 1
fi

java -jar "$JAR" "$@"
